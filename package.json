{\n  "name": "@uriesmooth/p2pv26",\n  "version": "26.1.0",\n  "description": "Core P2P Mesh & Communication Engine within the Uriesmooth Application Suite. A serverless, zero-trust media engine using WebRTC, WebGPU hardware acceleration, and WASI WebAssembly for sub-15ms peer-to-peer audio, video, and data synchronization.",\n  "organization": "uriesmooth",\n  "author": {\n    "name": "Uriesmooth Team",\n    "email": "billywitt809@gmail.com",\n    "url": "https://uriesmooth.online"\n  },\n  "maintainers": [\n    {\n      "name": "Billy Witt",\n      "email": "billywitt809@gmail.com"\n    }\n  ],\n  "license": "Apache-2.0",\n  "type": "module",\n  "main": "dist/index.js",\n  "module": "dist/index.mjs",\n  "types": "dist/index.d.ts",\n  "exports": {\n    ".": {\n      "import": "./dist/index.mjs",\n      "require": "./dist/index.js",\n      "types": "./dist/index.d.ts"\n    },\n    "./phone": {\n      "import": "./dist/PhoneCallEngine.mjs",\n      "require": "./dist/PhoneCallEngine.js",\n      "types": "./dist/PhoneCallEngine.d.ts"\n    }\n  },\n  "bin": {\n    "uriesmooth-cli": "dist/uriesmooth-cli.js"\n  },\n  "engines": {\n    "node": ">=18.0.0",\n    "npm": ">=9.0.0"\n  },\n  "homepage": "https://uriesmooth.online",\n  "repository": {\n    "type": "git",\n    "url": "https://github.com/uriesmooth/uriesmooth-p2pv26.git",\n    "directory": "."\n  },\n  "bugs": {\n    "url": "https://github.com/uriesmooth/uriesmooth-p2pv26/issues",\n    "email": "billywitt809@gmail.com"\n  },\n  "keywords": [\n    "p2p",\n    "peer-to-peer",\n    "webrtc",\n    "mesh",\n    "communication",\n    "real-time",\n    "audio",\n    "video",\n    "data-sync",\n    "websocket",\n    "wasm",\n    "webassembly",\n    "wasi",\n    "webgpu",\n    "hardware-acceleration",\n    "zero-trust",\n    "serverless",\n    "latency-optimized",\n    "nat-traversal",\n    "stun",\n    "turn",\n    "ice",\n    "distributed",\n    "network",\n    "engine",\n    "media",\n    "streaming",\n    "encryption",\n    "decentralized"\n  ],\n  "scripts": {\n    "build": "tsc && esbuild src/index.ts --bundle --format=esm --outfile=dist/index.mjs && esbuild src/index.ts --bundle --format=cjs --outfile=dist/index.js",\n    "build:phone": "tsc src/PhoneCallEngine.ts --outDir dist && esbuild src/PhoneCallEngine.ts --bundle --format=esm --outfile=dist/PhoneCallEngine.mjs",\n    "build:wasm": "wasm-pack build src/wasm --target web --out-dir dist/wasm",\n    "dev": "tsc --watch",\n    "type-check": "tsc --noEmit",\n    "lint": "eslint src --ext .ts,.tsx",\n    "lint:fix": "eslint src --ext .ts,.tsx --fix",\n    "format": "prettier --write 'src/**/*.ts' --write 'src/**/*.tsx'",\n    "test": "vitest run",\n    "test:watch": "vitest",\n    "test:coverage": "vitest run --coverage",\n    "prepublishOnly": "npm run build && npm run type-check && npm run test",\n    "prepack": "npm run build",\n    "cli": "node dist/uriesmooth-cli.js"\n  },\n  "dependencies": {\n    "simple-peer": "^9.11.1",\n    "ws": "^8.14.2",\n    "eventemitter3": "^5.0.1",\n    "uuid": "^9.0.0",\n    "dayjs": "^1.11.9"\n  },\n  "devDependencies": {\n    "@types/node": "^20.3.1",\n    "@types/simple-peer": "^9.11.5",\n    "@typescript-eslint/eslint-plugin": "^6.0.0",\n    "@typescript-eslint/parser": "^6.0.0",\n    "eslint": "^8.44.0",\n    "prettier": "^3.0.0",\n    "typescript": "^5.1.3",\n    "esbuild": "^0.18.11",\n    "tsup": "^7.1.0",\n    "vitest": "^0.34.1",\n    "@vitest/ui": "^0.34.1",\n    "@vitest/coverage-v8": "^0.34.1",\n    "wasm-pack": "^1.3.4"\n  },\n  "optionalDependencies": {\n    "bufferutil": "^4.0.7",\n    "utf-8-validate": "^6.0.3"\n  },\n  "publishConfig": {\n    "access": "public",\n    "registry": "https://registry.npmjs.org/"\n  },\n  "files": [\n    "dist",\n    "src",\n    "README.md",\n    "LICENSE",\n    "CHANGELOG.md"\n  ],\n  "sideEffects": false,\n  "funding": {\n    "type": "github",\n    "url": "https://github.com/sponsors/uriesmooth"\n  }\n}\n